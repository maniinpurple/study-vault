    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.12.0",
    "idb": "^8.0.4",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
