# ── VaultLearn environment ────────────────────────────────────────────────
# Copy to .env.local. Everything is optional in development: with no DATABASE_URL
# the app runs in LOCAL mode (IndexedDB in the browser).

# AES-256-GCM master key for the BYOK API vault (32 bytes, base64). REQUIRED in production.
# Generate with: npm run vault:keygen
VAULT_ENCRYPTION_KEY=
# Comma-separated rotated-out keys that may still decrypt existing rows.
VAULT_ENCRYPTION_KEYS_PREVIOUS=

# PostgreSQL (setting DATABASE_URL switches the app to REMOTE mode).
# Supabase: DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true), DIRECT_URL = direct (port 5432).
DATABASE_URL=
DIRECT_URL=
# Force a mode instead of inferring it: local | remote
DATA_MODE=

# Supabase Auth / Storage (remote mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
