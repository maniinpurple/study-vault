# ── VaultLearn environment ────────────────────────────────────────────────
# Copy to .env.local (or .env). Next.js loads both; .env.local wins.

# PostgreSQL. DATABASE_URL is used by the app and by Prisma Migrate.
# On a pooled host (Neon, Supabase) set DATABASE_URL_POOLED to the pooled URL for the app and keep
# DATABASE_URL / DIRECT_URL on the direct connection for migrations.
DATABASE_URL=
DATABASE_URL_POOLED=
DIRECT_URL=

# Auth.js session signing secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# AES-256-GCM master key for the BYOK API key vault (32 bytes, base64). REQUIRED in production.
# Generate with: npm run vault:keygen
VAULT_ENCRYPTION_KEY=
# Comma-separated rotated-out keys that may still decrypt existing rows.
VAULT_ENCRYPTION_KEYS_PREVIOUS=
